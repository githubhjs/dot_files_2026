[user]
    name = Josh_HUANG
    email = huangjs@gmail.com
    signingkey = 739C5CBDD849166CE2476F3C5AF379430CFEB839

[alias]
    # Logs
    lg = log --graph --pretty=format:'%C(magenta)%h%Creset -%C(red)%d%Creset %s %C(dim green)(%cr) %C(cyan)<%an>%Creset' --abbrev-commit
    lol = log --graph --decorate --pretty=oneline --abbrev-commit
    lola = log --graph --decorate --pretty=oneline --abbrev-commit --all
    lolan = log --graph --decorate --pretty=oneline --abbrev-commit --all --name-status
    j = log --pretty=format:\"%h%x09%an%x09%ad%x09%s\"
    jespersfavourit = log --pretty=format:\"%h%x09%an%x09%ad%x09%s\"

    # Basic Commands
    st = status
    sd = status .
    s = status -uno
    br = branch
    ci = commit
    co = checkout
    di = diff
    ann = annotate
    sh = show

[core]
    excludesfile = /home/hjs/.gitignore
    fsync = none
    compression = 0

[credential]
    helper = store

[color]
    ui = auto
    branch = auto
    diff = auto
    interactive = auto
    status = auto

[difftool]
    prompt = false

[pull]
    rebase = false

[commit]
    gpgsign = false

[gui]
    pruneduringfetch = true

[push]
    recurseSubmodules = check
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential

# --- Added 2026 (see docs/ENV_NOTES.md) -------------------------------------
[merge]
    # diff3 works on every git; zdiff3 needs git >= 2.35 and makes merge/rebase fail on older ones
    conflictStyle = diff3

# Pager: delta when installed (https://github.com/dandavison/delta). Uncomment once it is on PATH.
# [core]
#     pager = delta
# [interactive]
#     diffFilter = delta --color-only
# [delta]
#     navigate = true
#     line-numbers = true

# Host-specific settings go last so they override everything above. A missing file is ignored.
[include]
    path = ~/.gitconfig.local

### source ~/.zsh_functions in your ~/.zshrc

dedup_env_var() {
    # Takes the name of the environment variable as the first argument
    local var_name="$1"
    local array

    # Check if the environment variable exists
    if [[ -z "${(P)var_name}" ]]; then
        echo "Environment variable '$var_name' is not set."
        return 1
    fi

    # Use a unique array to remove duplicates and preserve order
    typeset -U array
    array=("${(@s/:/)${(P)var_name}}")   # Split by ':' and assign to array
    export "$var_name"="${(j/:/)array}"  # Join array back to a colon-separated string
}

## parallel zip
function tar_pigz_compress() {
  if [[ -z "$1" || -z "$2" ]]; then
    echo "Usage: tar_pigz_compress <archive_name.tar.gz> <source_directory_or_files...>"
    echo "Example: tar_pigz_compress my_backup.tar.gz /path/to/data /another/file"
    return 1
  fi

  local archive_name="$1"
  shift # Remove the archive name from the arguments

  if [[ -z "$@" ]]; then
    echo "Error: No source directories or files specified for compression."
    return 1
  fi

  echo "Creating compressed archive '$archive_name' using pigz..."
  tar chf - "$@" | pigz -c > "$archive_name"

  if [[ $? -eq 0 ]]; then
    echo "Compression to '$archive_name' successful."
  else
    echo "Error during compression."
    return 1
  fi
}

